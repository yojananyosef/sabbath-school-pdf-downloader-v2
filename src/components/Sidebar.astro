---
// Sidebar.astro
---

<aside class="sidebar-panel card" id="sidebar" aria-label="Lista de trimestres">
  <div class="sidebar-header">
    <div class="sidebar-title">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
        <line x1="16" y1="2" x2="16" y2="6"></line>
        <line x1="8" y1="2" x2="8" y2="6"></line>
        <line x1="3" y1="10" x2="21" y2="10"></line>
      </svg>
      <span>Trimestres</span>
    </div>

    <div class="sidebar-header-actions">
      <span class="count-badge" id="qcount">0</span>
      <button id="sidebarClose" class="btn btn-ghost btn-icon drawer-close" title="Cerrar" aria-label="Cerrar lista de trimestres">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>

  <div class="year-filter-bar" id="yearFilterBar" style="display: none;">
    <!-- Rendered dynamically by app.ts -->
  </div>

  <div class="scroll-list" id="qlist">
    <!-- Initial Loading Skeleton -->
    <div class="loading-state">
      <div class="skeleton" style="height: 48px; margin-bottom: 8px;"></div>
      <div class="skeleton" style="height: 48px; margin-bottom: 8px;"></div>
      <div class="skeleton" style="height: 48px; margin-bottom: 8px;"></div>
      <div class="skeleton" style="height: 48px; margin-bottom: 8px;"></div>
      <div class="skeleton" style="height: 48px;"></div>
    </div>
  </div>
</aside>

<div class="sidebar-backdrop" id="sidebarBackdrop"></div>

<style>
  .sidebar-panel {
    position: sticky;
    top: 66px;
    height: calc(100vh - 86px);
    height: calc(100dvh - 86px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .sidebar-header {
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    background: rgba(17, 22, 34, 0.7);
    flex-shrink: 0;
  }

  .sidebar-header-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .drawer-close {
    display: none;
  }

  .sidebar-title {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-secondary);
    min-width: 0;
  }

  .count-badge {
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--accent-light);
    background: rgba(59, 130, 246, 0.12);
    border: 1px solid rgba(59, 130, 246, 0.25);
    padding: 1px 7px;
    border-radius: var(--radius-full);
  }

  .year-filter-bar {
    display: flex;
    gap: 5px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border-subtle);
    overflow-x: auto;
    background: var(--bg-canvas);
    flex-shrink: 0;
  }

  .year-filter-bar::-webkit-scrollbar {
    height: 3px;
  }

  .scroll-list {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 6px;
  }

  .loading-state {
    padding: 8px;
  }

  /* Responsive Drawer */
  .sidebar-backdrop {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.65);
    backdrop-filter: blur(4px);
    -webkit-backdrop-filter: blur(4px);
    z-index: 45;
  }

  @media (max-width: 980px) {
    .sidebar-panel {
      position: fixed;
      top: 0;
      bottom: 0;
      left: 0;
      width: min(340px, 88vw);
      height: 100vh;
      height: 100dvh;
      max-height: 100dvh;
      border-radius: 0;
      z-index: 50;
      /* `visibility` keeps the closed drawer out of the tab order and out of
             the accessibility tree, which translateX alone does not. */
      visibility: hidden;
      transform: translateX(-100%);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 0.25s;
      box-shadow: 0 0 40px rgba(0, 0, 0, 0.6);
      padding-top: env(safe-area-inset-top);
    }

    .sidebar-panel.open {
      visibility: visible;
      transform: translateX(0);
      transition: transform 0.25s cubic-bezier(0.4, 0, 0.2, 1),
        visibility 0s linear 0s;
    }

    .drawer-close {
      display: inline-flex;
    }

    .sidebar-backdrop.open {
      display: block;
    }

    .year-filter-bar {
      padding: 10px 12px;
    }

    .scroll-list {
      padding-bottom: calc(12px + env(safe-area-inset-bottom));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .sidebar-panel {
      transition: none;
    }
  }
</style>
