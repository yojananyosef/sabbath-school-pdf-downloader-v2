---
// Header.astro
---

<header class="app-header">
  <div class="header-inner">
    <div class="brand">
      <div class="brand-icon">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1-2.5-2.5Z"></path>
          <path d="M6 6h10"></path>
          <path d="M6 10h10"></path>
        </svg>
      </div>
      <div class="brand-text">
        <div class="brand-title">Sabbath School</div>
        <div class="brand-sub">Descargador de PDFs <span class="badge-api">API v2</span></div>
      </div>
    </div>

    <div class="header-search">
      <div class="search-input-wrapper">
        <svg class="search-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="8"></circle>
          <path d="m21 21-4.3-4.3"></path>
        </svg>
        <label for="qsearch" class="sr-only">Buscar trimestre</label>
        <input
          id="qsearch"
          type="search"
          placeholder="Buscar trimestre por título o año..."
          autocomplete="off"
          spellcheck="false"
        />
        <kbd class="search-kbd">/</kbd>
      </div>
    </div>

    <div class="header-actions">
      <div class="lang-selector">
        <svg class="globe-icon" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <label for="lang" class="sr-only">Seleccionar idioma</label>
        <select id="lang" title="Idioma de estudio">
          <option value="es">ES · Español</option>
          <option value="en">EN · English</option>
          <option value="pt">PT · Português</option>
          <option value="fr">FR · Français</option>
          <option value="de">DE · Deutsch</option>
          <option value="it">IT · Italiano</option>
          <option value="ro">RO · Română</option>
          <option value="ru">RU · Русский</option>
          <option value="uk">UK · Українська</option>
          <option value="ko">KO · 한국어</option>
        </select>
      </div>

      <button id="reload" class="btn btn-ghost btn-icon" title="Recargar lista de trimestres" aria-label="Recargar lista">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
          <path d="M3 3v5h5"></path>
          <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
          <path d="M16 21h5v-5"></path>
        </svg>
      </button>

      <button id="sidebarToggle" class="btn btn-ghost btn-icon mobile-only" title="Mostrar/ocultar trimestres" aria-label="Abrir trimestres">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="3" y1="12" x2="21" y2="12"></line>
          <line x1="3" y1="6" x2="21" y2="6"></line>
          <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
      </button>
    </div>
  </div>
</header>

<style>
  .app-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgba(10, 13, 20, 0.85);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    max-width: 1460px;
    margin: 0 auto;
    padding: 10px 20px;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }

  .brand-icon {
    width: 36px;
    height: 36px;
    border-radius: var(--radius-md);
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.2), rgba(37, 99, 235, 0.05));
    border: 1px solid rgba(59, 130, 246, 0.3);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .brand-text {
    display: flex;
    flex-direction: column;
  }

  .brand-title {
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--text-main);
  }

  .brand-sub {
    font-size: 11.5px;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .badge-api {
    font-size: 10px;
    font-family: var(--font-mono);
    color: var(--accent-light);
    background: rgba(59, 130, 246, 0.15);
    padding: 1px 5px;
    border-radius: 4px;
  }

  .header-search {
    flex: 1;
    max-width: 540px;
  }

  .search-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    width: 100%;
  }

  .search-icon {
    position: absolute;
    left: 12px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .search-input-wrapper input {
    width: 100%;
    padding: 8px 38px 8px 36px;
    background: var(--bg-input);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-main);
    transition: all 0.2s ease;
  }

  .search-input-wrapper input:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.2);
    background: #0f1522;
  }

  .search-kbd {
    position: absolute;
    right: 10px;
    padding: 2px 6px;
    font-size: 11px;
    font-family: var(--font-mono);
    color: var(--text-muted);
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: 4px;
    pointer-events: none;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-left: auto;
  }

  .lang-selector {
    position: relative;
    display: flex;
    align-items: center;
  }

  .globe-icon {
    position: absolute;
    left: 10px;
    color: var(--text-muted);
    pointer-events: none;
  }

  .lang-selector select {
    padding: 7px 12px 7px 32px;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    color: var(--text-main);
    cursor: pointer;
    font-weight: 500;
    transition: all 0.15s ease;
  }

  .lang-selector select:hover {
    border-color: var(--border-hover);
    background: var(--bg-panel-hover);
  }

  .lang-selector select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .btn-icon {
    width: 36px;
    height: 36px;
    padding: 0;
    border-radius: var(--radius-md);
  }

  .mobile-only {
    display: none;
  }

  @media (max-width: 980px) {
    .mobile-only {
      display: inline-flex;
    }
    .header-search {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .header-inner {
      padding: 10px 14px;
      gap: 10px;
    }
    .brand-sub {
      display: none;
    }
    .search-input-wrapper input {
      font-size: 13px;
    }
  }
</style>
